" y="1709.16" width="102.399" height="30.8348" as="geometry"/></mxCell><mxCell id="n114" value="junction: wires connect" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2502.82" y="1767.11" width="309.024" height="30.8348" as="geometry"/></mxCell><mxCell id="n115" value="Update (when stall = 0 and valid_input): if the row at pc_branch(5..2) is invalid or holds another tag, a" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1876.82" width="1277.58" height="29.1791" as="geometry"/></mxCell><mxCell id="n116" value="jump allocates it with counter 11 and a taken branch with counter 10 (weakly taken); a not-taken branch is" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1907" width="1289.63" height="29.1791" as="geometry"/></mxCell><mxCell id="n117" value="not allocated. If the row is this branch, a jr/jalr rewrites the target and a conditional branch steps the" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1937.18" width="1289.63" height="29.1791" as="geometry"/></mxCell><mxCell id="n118" value="counter up (taken) or down, saturating at 11 and 00. In fetch the inputs come registered from" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1967.36" width="1132.94" height="29.1791" as="geometry"/></mxCell><mxCell id="n119" value="latching_for_btb_update and stall is &#x27;0&#x27;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1900" y="1997.54" width="506.178" height="29.1791" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>