6;fontColor=#98A2B3;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3458.45" y="2546.96" width="237.168" height="23.3206" as="geometry"/></mxCell><mxCell id="n121" value="⋮   stages 2 … 14: the same, shifted by 4 … 28" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.1328;fontColor=#344054;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1780" y="1359.87" width="732.777" height="36.1328" as="geometry"/></mxCell><mxCell id="n122" value="KEY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=35.1826;fontColor=#101418;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="93.113" y="1970.7" width="66.8848" height="41.1826" as="geometry"/></mxCell><mxCell id="n123" value="data bus, width at tick" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2043.27" width="309.024" height="30.8348" as="geometry"/></mxCell><mxCell id="n124" value="Booth select / sign" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2101.22" width="257.367" height="30.8348" as="geometry"/></mxCell><mxCell id="n125" value="junction: wires connect" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2159.16" width="309.024" height="30.8348" as="geometry"/></mxCell><mxCell id="n126" value="sel = (negate, x2, non-zero) from the triplet: 000/111 -&gt; 0," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="176.821" width="735.188" height="29.1791" as="geometry"/></mxCell><mxCell id="n127" value="001/010 -&gt; A, 011 -&gt; 2A, 100 -&gt; -2A, 101/110 -&gt; -A. A negative" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="207" width="759.294" height="29.1791" as="geometry"/></mxCell><mxCell id="n128" value="row is the bitwise complement; the corrector adds the missing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="237.179" width="747.241" height="29.1791" as="geometry"/></mxCell><mxCell id="n129" value="+1s (neg_bits) as one extra row. The tree&#x27;s register splits the" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="267.358" width="771.347" height="29.1791" as="geometry"/></mxCell><mxCell id="n130" value="multiply into two cycles; final_add adds tree_c(31..0) and" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="297.537" width="711.082" height="29.1791" as="geometry"/></mxCell><mxCell id="n131" value="tree_s(31..0): the product is the low 32 bits." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2950" y="327.716" width="566.444" height="29.1791" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>