align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="1679.16" width="102.399" height="30.8348" as="geometry"/></mxCell><mxCell id="n163" value="junction: wires connect" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="1737.11" width="309.024" height="30.8348" as="geometry"/></mxCell><mxCell id="n164" value="The branch is resolved in ID. mux_2 picks the address the branch really goes to; flush" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1836.82" width="1048.57" height="29.1791" as="geometry"/></mxCell><mxCell id="n165" value="fires when it differs from what fetch predicted. The prediction is compared with all" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1867" width="1024.46" height="29.1791" as="geometry"/></mxCell><mxCell id="n166" value="three candidates in parallel and decision &amp; JR_bit_t only pick one mismatch bit (V2)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1897.18" width="1036.52" height="29.1791" as="geometry"/></mxCell><mxCell id="n167" value="The comparators use bits 31..2 of p4_S and register_in. CAUSE_t is declared in the VHDL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1927.36" width="1060.62" height="29.1791" as="geometry"/></mxCell><mxCell id="n168" value="but not used." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="60" y="1957.54" width="168.691" height="29.1791" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>