="n202" value="DLX  ·  RTL schematic set" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=21.3177;fontColor=#98A2B3;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="4260.49" y="3138.96" width="289.13" height="27.3177" as="geometry"/></mxCell><mxCell id="n203" value="carry_select_block  (one of the 8; NBIT = 4)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=34.2338;fontColor=#344054;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="660" y="1975.77" width="918.784" height="40.2338" as="geometry"/></mxCell><mxCell id="n204" value="KEY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=43.3016;fontColor=#101418;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="2940.75" y="2075.47" width="79.5505" height="49.3016" as="geometry"/></mxCell><mxCell id="n205" value="data bus, width at tick" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.5659;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3149.62" y="2165.72" width="377.568" height="36.5659" as="geometry"/></mxCell><mxCell id="n206" value="g / p pair, carry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.5659;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3149.62" y="2237.04" width="282.202" height="36.5659" as="geometry"/></mxCell><mxCell id="n207" value="G block  (G = Gik + Pik·Gk-1j)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.5659;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3149.62" y="2308.36" width="488.827" height="36.5659" as="geometry"/></mxCell><mxCell id="n208" value="PG block (also P = Pik·Pk-1j)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.5659;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3149.62" y="2379.68" width="472.933" height="36.5659" as="geometry"/></mxCell><mxCell id="n209" value="A node&#x27;s left input is its own column, the right input the column it combines with. The" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28.5281;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2900" y="2471.47" width="1302.61" height="34.5281" as="geometry"/></mxCell><mxCell id="n210" value="tree computes only every 4th carry, in log2(32/4) + 2 = 5 layers; each 4-bit block of the" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28.5281;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2900" y="2507" width="1332.28" height="34.5281" as="geometry"/></mxCell><mxCell id="n211" value="sum generator computes both possible sums and the carry picks one, so the carry tree and" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28.5281;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2900" y="2542.53" width="1317.45" height="34.5281" as="geometry"/></mxCell><mxCell id="n212" value="the 4-bit adds work in parallel." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28.5281;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="2900" y="2578.06" width="486.708" height="34.5281" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>