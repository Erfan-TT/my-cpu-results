="1"><mxGeometry x="2786.28" y="2464.69" width="831.613" height="34.1461" as="geometry"/></mxCell><mxCell id="n132" value="ControlPath/hazard_detection.vhd : beh" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20.5683;fontColor=#475467;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="2786.28" y="2513.4" width="482.52" height="26.5683" as="geometry"/></mxCell><mxCell id="n133" value="DLX  ·  RTL schematic set" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=17.3206;fontColor=#98A2B3;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="3458.45" y="2546.96" width="237.168" height="23.3206" as="geometry"/></mxCell><mxCell id="n134" value="KEY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=35.1826;fontColor=#101418;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="93.113" y="1970.7" width="66.8848" height="41.1826" as="geometry"/></mxCell><mxCell id="n135" value="address / count, width at tick" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2043.27" width="399.422" height="30.8348" as="geometry"/></mxCell><mxCell id="n136" value="comparison result" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2101.22" width="231.539" height="30.8348" as="geometry"/></mxCell><mxCell id="n137" value="control" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2159.16" width="102.399" height="30.8348" as="geometry"/></mxCell><mxCell id="n138" value="junction: wires connect" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.8348;fontColor=#101418;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="262.817" y="2217.11" width="309.024" height="30.8348" as="geometry"/></mxCell><mxCell id="n139" value="Stall (none while stall_outside): [rs1]≠0 for a branch or jump that reads a register (valid_bit and RF1 or RF2, no MEM-&gt;ID path); [rs1]&gt;1 for" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1150" y="1966.82" width="1711.49" height="29.1791" as="geometry"/></mxCell><mxCell id="n140" value="RF1 and [rs2]&gt;1 for RF2 (a load or multiply one ahead); SP[rs2]≠0 for movs2i (SP_read); shift_bit and not mul_or_not (the multiplier&#x27;s result" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1150" y="1997" width="1711.49" height="29.1791" as="geometry"/></mxCell><mxCell id="n141" value="takes the write-back port next cycle). Update, when not stalled: SP_write writes SP[rd] = 2; else WF1 writes G[rd] = 2 for a load or" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1150" y="2027.18" width="1603.01" height="29.1791" as="geometry"/></mxCell><mxCell id="n142" value="multiply, 1 otherwise, and a multiply sets shift_bit. All counters count down; rst or special_pc_sel clears them." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=23.1791;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1150" y="2057.36" width="1374" height="29.1791" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>