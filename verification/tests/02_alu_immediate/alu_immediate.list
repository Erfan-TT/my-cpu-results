    1                      ;=============================================================================
    2                      ;  02_alu_immediate -- I-type ALU, and the sign- vs zero-extension split
    3                      ;=============================================================================
    4                      ;  Checklist: A4 (addi/addui/subi/subui/andi/ori/xori), A5 (slli/srli/srai),
    5                      ;             A6 (lhi).
    6                      ;
    7                      ;  The point of this program is the immediate path, not the ALU: addi/subi
    8                      ;  sign-extend the 16-bit field, addui/subui/andi/ori/xori zero-extend it, and
    9                      ;  the pairs below use the SAME immediate so a broken sign_extension.vhd shows
   10                      ;  up as two adjacent words that are wrong in opposite directions.
   11                      ;
   12                      ;  Result map:
   13                      ;    0 addi -1        1 addui 0xFFFF   2 addi +max      3 addi -min
   14                      ;    4 subi -1        5 subui 0xFFFF   6 subi 1         7 andi low
   15                      ;    8 andi ones      9 ori zero      10 ori mix       11 xori low
   16                      ;   12 xori ones     13 lhi 0x1234    14 lhi 0xFFFF    15 lhi 0
   17                      ;   16 slli 4        17 slli 0        18 slli 31       19 srli 4
   18                      ;   20 srli 31       21 srai 31       22 srai 4        23 srai INT_MIN 1
   19                      ;   24 addi 0        25 addui 0x8000  26 subui 0x8000  27 addi -32768
   20                      ;=============================================================================
   21  00000000          	
   22  00000000          	.text
   23  00000000          	
   24                      ;---- operands ---------------------------------------------------------------
   25  00000000  3c015a5a	lhi  r1, 0x5A5A
   26  00000004  34210f0f	ori  r1, r1, 0x0F0F         ; r1 = 0x5A5A0F0F
   27  00000008  2004ffff	addi r4, r0, -1             ; r4 = 0xFFFFFFFF
   28  0000000c  3c068000	lhi  r6, 0x8000             ; r6 = 0x80000000
   29  00000010          	
   30                      ;---- addi / addui : same 16-bit field, different extension ------------------
   31  00000010  200affff	addi  r10, r0, -1           ; sign-extended -> 0xFFFFFFFF
   32  00000014  ac0a0000	sw     0(r0), r10
   33  00000018  240affff	addui r10, r0, 0xFFFF       ; zero-extended -> 0x0000FFFF
   34  0000001c  ac0a0004	sw     4(r0), r10
   35  00000020  202a7fff	addi  r10, r1, 32767        ; largest positive immediate
   36  00000024  ac0a0008	sw     8(r0), r10
   37  00000028  202a8000	addi  r10, r1, -32768       ; most negative immediate
   38  0000002c  ac0a000c	sw    12(r0), r10
   39  00000030          	
   40                      ;---- subi / subui -----------------------------------------------------------
   41  00000030  280affff	subi  r10, r0, -1           ; 0-(-1) -> 1
   42  00000034  ac0a0010	sw    16(r0), r10
   43  00000038  2c0affff	subui r10, r0, 0xFFFF       ; 0-65535 -> 0xFFFF0001
   44  0000003c  ac0a0014	sw    20(r0), r10
   45  00000040  282a0001	subi  r10, r1, 1
   46  00000044  ac0a0018	sw    24(r0), r10
   47  00000048          	
   48                      ;---- andi / ori / xori : always zero-extended -------------------------------
   49  00000048  302affff	andi r10, r1, 0xFFFF        ; 0x00000F0F
   50  0000004c  ac0a001c	sw    28(r0), r10
   51  00000050  308affff	andi r10, r4, 0xFFFF        ; 0x0000FFFF, proves the upper half is 0
   52  00000054  ac0a0020	sw    32(r0), r10
   53  00000058  340affff	ori  r10, r0, 0xFFFF        ; 0x0000FFFF
   54  0000005c  ac0a0024	sw    36(r0), r10
   55  00000060  342af0f0	ori  r10, r1, 0xF0F0        ; 0x5A5AFFFF
   56  00000064  ac0a0028	sw    40(r0), r10
   57  00000068  382affff	xori r10, r1, 0xFFFF        ; 0x5A5AF0F0
   58  0000006c  ac0a002c	sw    44(r0), r10
   59  00000070  388affff	xori r10, r4, 0xFFFF        ; 0xFFFF0000
   60  00000074  ac0a0030	sw    48(r0), r10
   61  00000078          	
   62                      ;---- lhi --------------------------------------------------------------------
   63  00000078  3c0a1234	lhi  r10, 0x1234            ; 0x12340000
   64  0000007c  ac0a0034	sw    52(r0), r10
   65  00000080  3c0affff	lhi  r10, 0xFFFF            ; 0xFFFF0000
   66  00000084  ac0a0038	sw    56(r0), r10
   67  00000088  3c0a0000	lhi  r10, 0                 ; 0
   68  0000008c  ac0a003c	sw    60(r0), r10
   69  00000090          	
   70                      ;---- immediate shifts -------------------------------------------------------
   71  00000090  502a0004	slli r10, r1, 4
   72  00000094  ac0a0040	sw    64(r0), r10
   73  00000098  502a0000	slli r10, r1, 0             ; no-op
   74  0000009c  ac0a0044	sw    68(r0), r10
   75  000000a0  502a001f	slli r10, r1, 31            ; only bit 0 of r1 survives
   76  000000a4  ac0a0048	sw    72(r0), r10
   77  000000a8  582a0004	srli r10, r1, 4
   78  000000ac  ac0a004c	sw    76(r0), r10
   79  000000b0  588a001f	srli r10, r4, 31            ; logical -> 1
   80  000000b4  ac0a0050	sw    80(r0), r10
   81  000000b8  5c8a001f	srai r10, r4, 31            ; arithmetic -> 0xFFFFFFFF
   82  000000bc  ac0a0054	sw    84(r0), r10
   83  000000c0  5c2a0004	srai r10, r1, 4             ; positive, so same as srli
   84  000000c4  ac0a0058	sw    88(r0), r10
   85  000000c8  5cca0001	srai r10, r6, 1             ; INT_MIN >> 1 -> 0xC0000000
   86  000000cc  ac0a005c	sw    92(r0), r10
   87  000000d0          	
   88                      ;---- the extension split once more, on a value with bit 15 set --------------
   89  000000d0  202a0000	addi  r10, r1, 0            ; identity
   90  000000d4  ac0a0060	sw    96(r0), r10
   91  000000d8  242a8000	addui r10, r1, 0x8000       ; + 32768
   92  000000dc  ac0a0064	sw   100(r0), r10
   93  000000e0  2c2a8000	subui r10, r1, 0x8000       ; - 32768
   94  000000e4  ac0a0068	sw   104(r0), r10
   95  000000e8  202a8000	addi  r10, r1, -32768       ; also - 32768, via sign extension
   96  000000ec  ac0a006c	sw   108(r0), r10
   97  000000f0          	
   98  000000f0  0bfffffc	end:    j end
