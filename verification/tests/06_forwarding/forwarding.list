 line   address	contents
    1                      ;=============================================================================
    2                      ;  06_forwarding -- every forwarding path, and the cases that must NOT forward
    3                      ;=============================================================================
    4                      ;  Checklist: C1 (EX->EX), C2 (MEM->EX), C3 (register-file read-during-write
    5                      ;  bypass), C7 (link_bit and SP_read cancellation), C8 (no forwarding out of a
    6                      ;  store or a branch), C10 (special-register scoreboard).
    7                      ;  Load-use and load->store are in 07_load_use; the EX->ID branch path is in
    8                      ;  10_branches.
    9                      ;
   10                      ;  Each distance is written the same way -- 100 + 7 = 107, then + 7 = 114 --
   11                      ;  so all four of the first results must read 114.  A missing forward gives a
   12                      ;  stale operand and a visibly different number, not a near miss.
   13                      ;
   14                      ;  Result map:
   15                      ;    0 EX->EX rs1     1 EX->EX rs2     2 MEM->EX rs1    3 MEM->EX rs2
   16                      ;    4 RF bypass      5 5-deep chain   6 store data     7 read after store
   17                      ;    8 read after a taken branch       9 r31 after jr  10 r31 at distance 1
   18                      ;   11 movs2i VBR    12 movs2i IAR
   19                      ;=============================================================================
   20  00000000          	
   21  00000000          	.text
   22  00000000          	
   23  00000000  20010064	addi r1, r0, 100
   24  00000004  20020007	addi r2, r0, 7
   25  00000008          	
   26                      ;---- C1: EX->EX, distance 1 -------------------------------------------------
   27  00000008  00221820	add  r3, r1, r2             ; 107
   28  0000000c  00622020	add  r4, r3, r2             ; rs1 comes from EX  -> 114
   29  00000010  ac040000	sw    0(r0), r4
   30  00000014  00222820	add  r5, r1, r2             ; 107
   31  00000018  00453020	add  r6, r2, r5             ; rs2 comes from EX  -> 114
   32  0000001c  ac060004	sw    4(r0), r6
   33  00000020          	
   34                      ;---- C2: MEM->EX, distance 2 ------------------------------------------------
   35  00000020  00223820	add  r7, r1, r2
   36  00000024  54000000	nop
   37  00000028  00e24020	add  r8, r7, r2             ; rs1 comes from MEM -> 114
   38  0000002c  ac080008	sw    8(r0), r8
   39  00000030  00224820	add  r9, r1, r2
   40  00000034  54000000	nop
   41  00000038  00495820	add  r11, r2, r9            ; rs2 comes from MEM -> 114
   42  0000003c  ac0b000c	sw   12(r0), r11
   43  00000040          	
   44                      ;---- C3: register-file read-during-write bypass, distance 3 -----------------
   45  00000040  00226020	add  r12, r1, r2
   46  00000044  54000000	nop
   47  00000048  54000000	nop
   48  0000004c  01826820	add  r13, r12, r2           ; producer is in WB  -> 114
   49  00000050  ac0d0010	sw   16(r0), r13
   50  00000054          	
   51                      ;---- back-to-back chain: forwarding on every single instruction -------------
   52  00000054  200e0001	addi r14, r0, 1
   53  00000058  01ce7020	add  r14, r14, r14          ; 2
   54  0000005c  01ce7020	add  r14, r14, r14          ; 4
   55  00000060  01ce7020	add  r14, r14, r14          ; 8
   56  00000064  01ce7020	add  r14, r14, r14          ; 16
   57  00000068  ac0e0014	sw   20(r0), r14
   58  0000006c          	
   59                      ;---- C8: a store writes no register, so nothing may be forwarded from it ----
   60  0000006c  200f0037	addi r15, r0, 55
   61  00000070  ac0f0018	sw   24(r0), r15            ; rs2 = r15 forwarded into the store
   62  00000074  01e08020	add  r16, r15, r0           ; r15 is still 55, not the store address
   63  00000078  ac10001c	sw   28(r0), r16
   64  0000007c          	
   65                      ;---- C8: a branch writes no register either ---------------------------------
   66  0000007c  20110003	addi r17, r0, 3
   67  00000080  10000004	beqz r0, fw_cont            ; always taken
   68  00000084  20110063	addi r17, r0, 99            ; must be flushed, never executed
   69  00000088          	fw_cont:
   70  00000088  02209020	add  r18, r17, r0           ; still 3
   71  0000008c  ac120020	sw   32(r0), r18
   72  00000090          	
   73                      ;---- C7: the link value, not the ALU output ---------------------------------
   74                      ;  jal writes r31 through the link path.  fw_sub reads r31 one instruction
   75                      ;  later, so whatever the forwarding network hands over has to be PC+4 of the
   76                      ;  jal -- which is the address of the 'sw 36' below, where jr returns to.
   77  00000090  0c000008	jal  fw_sub
   78  00000094  ac1f0024	sw   36(r0), r31            ; reached by the jr, stores its own address
   79  00000098  0800000c	j    fw_after
   80  0000009c          	fw_sub:
   81  0000009c  03e09820	add  r19, r31, r0           ; r31 at forwarding distance 1
   82  000000a0  ac130028	sw   40(r0), r19
   83  000000a4  4be00000	jr   r31
   84  000000a8          	fw_after:
   85  000000a8          	
   86                      ;---- C7 / C10: the special-register scoreboard ------------------------------
   87                      ;  movs2i must not read the special register file before movi2s has written
   88                      ;  it; the SP scoreboard holds the reader for two cycles.  Forwarding into a
   89                      ;  movs2i's rs2 is cancelled, because that field is an SR index, not a GPR.
   90  000000a8  201402a0	addi r20, r0, 672
   91  000000ac  02800030	movi2s VBR, r20
   92  000000b0  0000a831	movs2i r21, VBR             ; must see 672
   93  000000b4  ac15002c	sw   44(r0), r21
   94  000000b8  00200830	movi2s IAR, r1
   95  000000bc  0001b031	movs2i r22, IAR             ; must see 100
   96  000000c0  ac160030	sw   48(r0), r22
   97  000000c4          	
   98  000000c4  0bfffffc	end:    j end
