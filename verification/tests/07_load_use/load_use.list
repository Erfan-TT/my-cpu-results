    1                      ;=============================================================================
    2                      ;  07_load_use -- the load-use hazard and the load-driven forwarding paths
    3                      ;=============================================================================
    4                      ;  Checklist: C4 (load-use stall at distance 1), C2/C3 at distances 2 and 3,
    5                      ;             C5 (load -> store data, fw_mem_mem), plus address generation
    6                      ;             that itself depends on a load.
    7                      ;
    8                      ;  The scoreboard gives a load's destination a count of 2, so only distance 1
    9                      ;  stalls; distances 2 and 3 must come through forwarding with no bubble.  All
   10                      ;  three read the same kind of value, so a wrong one is obvious.
   11                      ;
   12                      ;  Inputs live in the .data section, i.e. in the dmem_init image, so this test
   13                      ;  also proves the initial data memory is loaded at all.
   14                      ;
   15                      ;  Result map:
   16                      ;    0 load-use d1    1 load d2        2 load d3        3 load->store
   17                      ;    4 pointer chase  5 chase x2       6 load -> branch 7 store then load
   18                      ;    8 negative disp  9 disp -4       10 store at a negative displacement
   19                      ;=============================================================================
   20  00000000          	
   21  00000000          	.text
   22  00000000          	
   23  00000000  20010080	addi r1, r0, src            ; base pointer, 0x80
   24  00000004          	
   25                      ;---- C4: distance 1, the one case that must stall ---------------------------
   26  00000004  8c220000	lw   r2, 0(r1)
   27  00000008  00401820	add  r3, r2, r0             ; 0x11223344
   28  0000000c  ac030000	sw    0(r0), r3
   29  00000010          	
   30                      ;---- distance 2: MEM->EX, no stall ------------------------------------------
   31  00000010  8c240004	lw   r4, 4(r1)
   32  00000014  54000000	nop
   33  00000018  00802820	add  r5, r4, r0             ; 0xAABBCCDD
   34  0000001c  ac050004	sw    4(r0), r5
   35  00000020          	
   36                      ;---- distance 3: register-file bypass ---------------------------------------
   37  00000020  8c260008	lw   r6, 8(r1)
   38  00000024  54000000	nop
   39  00000028  54000000	nop
   40  0000002c  00c03820	add  r7, r6, r0             ; 42
   41  00000030  ac070008	sw    8(r0), r7
   42  00000034          	
   43                      ;---- C5: the loaded word goes straight back out as store data ---------------
   44  00000034  8c28000c	lw   r8, 12(r1)
   45  00000038  ac08000c	sw   12(r0), r8             ; 0xFFFFFFFF, via MEM->MEM forwarding
   46  0000003c          	
   47                      ;---- the address of a load produced by the previous load --------------------
   48  0000003c  8c290010	lw   r9, 16(r1)             ; r9 = 0x88
   49  00000040  8d2b0000	lw   r11, 0(r9)             ; 42
   50  00000044  ac0b0010	sw   16(r0), r11
   51  00000048  8c2c0014	lw   r12, 20(r1)            ; r12 = 0x98
   52  0000004c  8d8d0000	lw   r13, 0(r12)            ; 123
   53  00000050  ac0d0014	sw   20(r0), r13
   54  00000054          	
   55                      ;---- a load feeding a branch condition resolved in ID -----------------------
   56  00000054  8c2e0008	lw   r14, 8(r1)             ; 42, non-zero
   57  00000058  15c00004	bnez r14, lu_taken
   58  0000005c  200f03e7	addi r15, r0, 999           ; flushed, never executed
   59  00000060          	lu_taken:
   60  00000060  8c300000	lw   r16, 0(r1)             ; 0x11223344, non-zero
   61  00000064  12000004	beqz r16, lu_join           ; not taken
   62  00000068  200f0007	addi r15, r0, 7
   63  0000006c          	lu_join:
   64  0000006c  ac0f0018	sw   24(r0), r15            ; 7
   65  00000070          	
   66                      ;---- store then read the same address back ----------------------------------
   67  00000070  201105a5	addi r17, r0, 1445
   68  00000074  ac110040	sw   64(r0), r17
   69  00000078  8c120040	lw   r18, 64(r0)
   70  0000007c  ac12001c	sw   28(r0), r18
