   73  00000080  20130090	addi r19, r0, 144           ; 0x90, one word past src[3]
   74  00000084  8e74fff0	lw   r20, -16(r19)          ; src[0]
   75  00000088  ac140020	sw   32(r0), r20
   76  0000008c  8e75fffc	lw   r21, -4(r19)           ; src[3]
   77  00000090  ac150024	sw   36(r0), r21
