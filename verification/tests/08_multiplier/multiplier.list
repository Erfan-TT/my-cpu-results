    1                      ;=============================================================================
    2                      ;  08_multiplier -- Booth / Dadda correctness on the corner operands
    3                      ;=============================================================================
    4                      ;  Checklist: B1.  Timing and overlap are 09_mult_parallel's job; this file is
    5                      ;  only about the product being right.
    6                      ;
    7                      ;  mult is a 32x32 -> low 32 multiply, so signed and unsigned agree on the
    8                      ;  result and the cases that matter are the ones that stress Booth recoding:
    9                      ;  zero, +1 and -1 multipliers (the "+1 correction" terms), runs of 01 and 10
   10                      ;  pairs (0x55555555 / 0xAAAAAAAA), the powers of two that land exactly on the
   11                      ;  32-bit boundary, and INT_MIN, whose negation does not fit.
   12                      ;
   13                      ;  Every 'sw' sits directly on top of its mult, so each case is also a
   14                      ;  dependent consumer at distance 1 -- the multiplier's stall path.
   15                      ;
   16                      ;  Result map:
   17                      ;    0  6*7          1 (-6)*(-7)    2  6*(-7)      3 (-6)*7
   18                      ;    4  6*0          5  0*6         6  x*1         7  1*x
   19                      ;    8  x*(-1)       9 (-1)*(-1)   10  INT_MIN*1  11  INT_MIN*(-1)
   20                      ;   12  INT_MIN^2   13  INT_MAX*2  14  2^16 sq    15  2^15 sq
   21                      ;   16  0x55555555*3               17  0xAAAAAAAA*3
   22                      ;   18  0x12345678*0x9ABCDEF0      19  0x9ABCDEF0 squared
   23                      ;   20  0x55555555*0xAAAAAAAA
   24                      ;=============================================================================
   25  00000000          	
   26  00000000          	.text
   27  00000000          	
   28  00000000  20140080	addi r20, r0, ops
   29  00000004  8e810000	lw   r1,  0(r20)            ; 0x80000000  INT_MIN
   30  00000008  8e820004	lw   r2,  4(r20)            ; 0x7FFFFFFF  INT_MAX
   31  0000000c  8e830008	lw   r3,  8(r20)            ; 0xFFFFFFFF  -1
   32  00000010  8e84000c	lw   r4, 12(r20)            ; 0x00010000  2^16
   33  00000014  8e850010	lw   r5, 16(r20)            ; 0x00008000  2^15
   34  00000018  8e860014	lw   r6, 20(r20)            ; 0x55555555
   35  0000001c  8e870018	lw   r7, 24(r20)            ; 0xAAAAAAAA
   36  00000020  8e88001c	lw   r8, 28(r20)            ; 0x12345678
   37  00000024  8e890020	lw   r9, 32(r20)            ; 0x9ABCDEF0
   38  00000028  200b0006	addi r11, r0, 6
   39  0000002c  200cfffa	addi r12, r0, -6
   40  00000030  200d0007	addi r13, r0, 7
   41  00000034  200efff9	addi r14, r0, -7
   42  00000038  200f0003	addi r15, r0, 3
   43  0000003c  20110001	addi r17, r0, 1
   44  00000040  20120002	addi r18, r0, 2
   45  00000044          	
   46                      ;---- sign combinations ------------------------------------------------------
   47  00000044  016d802e	mult r16, r11, r13          ; 42
   48  00000048  ac100000	sw    0(r0), r16
   49  0000004c  018e802e	mult r16, r12, r14          ; 42
   50  00000050  ac100004	sw    4(r0), r16
   51  00000054  016e802e	mult r16, r11, r14          ; -42
   52  00000058  ac100008	sw    8(r0), r16
   53  0000005c  018d802e	mult r16, r12, r13          ; -42
   54  00000060  ac10000c	sw   12(r0), r16
   55  00000064          	
   56                      ;---- zero and identity, on both operand positions ---------------------------
   57  00000064  0160802e	mult r16, r11, r0           ; 0
   58  00000068  ac100010	sw   16(r0), r16
   59  0000006c  000b802e	mult r16, r0, r11           ; 0
   60  00000070  ac100014	sw   20(r0), r16
   61  00000074  0111802e	mult r16, r8, r17           ; identity
   62  00000078  ac100018	sw   24(r0), r16
   63  0000007c  0228802e	mult r16, r17, r8           ; identity, other side
   64  00000080  ac10001c	sw   28(r0), r16
   65  00000084          	
   66                      ;---- the -1 multiplier: Booth's negative partial products -------------------
   67  00000084  0103802e	mult r16, r8, r3            ; two's-complement negate
   68  00000088  ac100020	sw   32(r0), r16
   69  0000008c  0063802e	mult r16, r3, r3            ; (-1)*(-1) = 1
   70  00000090  ac100024	sw   36(r0), r16
   71  00000094          	
   72                      ;---- INT_MIN, whose negation does not fit in 32 bits ------------------------
   73  00000094  0031802e	mult r16, r1, r17           ; 0x80000000
