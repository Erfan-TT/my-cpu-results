   80  000000b0  ac100034	sw   52(r0), r16
   81  000000b4          	
   82                      ;---- products that fall on the 32-bit boundary ------------------------------
   83  000000b4  0084802e	mult r16, r4, r4            ; 2^32, low 32 bits are 0
   84  000000b8  ac100038	sw   56(r0), r16
   85  000000bc  00a5802e	mult r16, r5, r5            ; 2^30
   86  000000c0  ac10003c	sw   60(r0), r16
   87  000000c4          	
   88                      ;---- alternating-bit operands: every Booth pair is exercised ----------------
   89  000000c4  00cf802e	mult r16, r6, r15           ; 0x55555555 * 3
   90  000000c8  ac100040	sw   64(r0), r16
   91  000000cc  00ef802e	mult r16, r7, r15           ; 0xAAAAAAAA * 3
   92  000000d0  ac100044	sw   68(r0), r16
   93  000000d4  0109802e	mult r16, r8, r9
   94  000000d8  ac100048	sw   72(r0), r16
   95  000000dc  0129802e	mult r16, r9, r9
   96  000000e0  ac10004c	sw   76(r0), r16
   97  000000e4  00c7802e	mult r16, r6, r7
   98  000000e8  ac100050	sw   80(r0), r16
