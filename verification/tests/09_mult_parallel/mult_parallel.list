   55  0000005c  0022802e	mult r16, r1, r2            ; 42
   56  00000060  0043882e	mult r17, r2, r3            ; 21
   57  00000064  0023902e	mult r18, r1, r3            ; 18
   58  00000068  ac100014	sw   20(r0), r16
   59  0000006c  ac110018	sw   24(r0), r17
   60  00000070  ac12001c	sw   28(r0), r18
   61  00000074          	
   62                      ;---- a chain where every multiply feeds the next ----------------------------
   63  00000074  20130002	addi r19, r0, 2
