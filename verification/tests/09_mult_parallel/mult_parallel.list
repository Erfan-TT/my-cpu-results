  100  000000e0  ac1d0030	sw   48(r0), r29
  101  000000e4          	
  102                      ;---- WAW: an ALU write landing on a register a multiply still owns ----------
  103                      ;  The multiplier writes back out of order and the scoreboard does not order
  104                      ;  writes to the same destination.  The golden model retires in program order,
  105                      ;  so it says 5.  A mismatch here is a design limitation worth knowing about,
  106                      ;  not a bad stimulus -- see verification/README.md.
  107  000000e4  0022f02e	mult r30, r1, r2            ; 42, in flight
  108  000000e8  201e0005	addi r30, r0, 5             ; overwrites it one instruction later
  109  000000ec  ac1e0034	sw   52(r0), r30
  110  000000f0          	
  111  000000f0  0bfffffc	end:    j end
