    1                      ;=============================================================================
    2                      ;  09_mult_parallel -- the multiplier running alongside the rest of the pipe
    3                      ;=============================================================================
    4                      ;  Checklist: B2 (independent work issued under a multiply, out-of-order
    5                      ;  writeback through the shadowed rd), B3 (dependent consumer at distances
    6                      ;  1/2/3 -- only distance 1 may stall), B4 (back-to-back multiplies and the
    7                      ;  structural hazard on the shared writeback port), B5 (a product deciding a
    8                      ;  branch in ID), B6 (a multiply in flight across a jal/jr boundary).
    9                      ;
   10                      ;  The products themselves are trivial here on purpose; 08_multiplier already
   11                      ;  proves the arithmetic.  What is under test is that the right value reaches
   12                      ;  the right instruction at the right time.
   13                      ;
   14                      ;  Result map:
   15                      ;    0 product, overlapped        1 independent work underneath it
   16                      ;    2 consumer at distance 1     3 at distance 2      4 at distance 3
   17                      ;    5 back-to-back A             6 back-to-back B     7 back-to-back C
   18                      ;    8 dependent multiply chain   9 branch on a zero product
   19                      ;   10 branch on a non-zero product          11 product across jal/jr
   20                      ;   12 product as store data     13 WAW: ALU write over a multiply in flight
   21                      ;   20 written through a product used as a store ADDRESS
   22                      ;=============================================================================
   23  00000000          	
   24  00000000          	.text
   25  00000000          	
   26  00000000  20010006	addi r1, r0, 6
   27  00000004  20020007	addi r2, r0, 7
   28  00000008  20030003	addi r3, r0, 3
   29  0000000c          	
   30                      ;---- B2: the pipeline must not stop while the multiplier works --------------
   31  0000000c  0022202e	mult r4, r1, r2             ; 42, writes back out of order
   32  00000010  2005000b	addi r5, r0, 11             ; none of these four may be delayed
   33  00000014  2006000c	addi r6, r0, 12
   34  00000018  2007000d	addi r7, r0, 13
   35  0000001c  00a64020	add  r8, r5, r6             ; 23
   36  00000020  01074020	add  r8, r8, r7             ; 36
   37  00000024  ac040000	sw    0(r0), r4
   38  00000028  ac080004	sw    4(r0), r8
   39  0000002c          	
   40                      ;---- B3: the three consumer distances ---------------------------------------
   41  0000002c  0022482e	mult r9, r1, r2
   42  00000030  01205820	add  r11, r9, r0            ; distance 1, must stall
   43  00000034  ac0b0008	sw    8(r0), r11            ; 42
   44  00000038  0023602e	mult r12, r1, r3
   45  0000003c  54000000	nop
   46  00000040  01806820	add  r13, r12, r0           ; distance 2
   47  00000044  ac0d000c	sw   12(r0), r13            ; 18
   48  00000048  0043702e	mult r14, r2, r3
   49  0000004c  54000000	nop
   50  00000050  54000000	nop
   51  00000054  01c07820	add  r15, r14, r0           ; distance 3
   52  00000058  ac0f0010	sw   16(r0), r15            ; 21
   53  0000005c          	
