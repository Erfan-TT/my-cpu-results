  118                      ;---- D10: where the condition comes from -----------------------------------
  119                      ;  The branch resolves in ID.  At distance 1 the producer is still in EX and
  120                      ;  its zero/sign flags are forwarded EX->ID; at distance 3 and beyond the
  121                      ;  register file bypass covers it.  Distance 2 is the hole -- see
  122                      ;  22_branch_operand_hazard, which owns that case.
  123                      ;
  124                      ;  r5 is deliberately NON-zero before each producer, so a stale read gives a
  125                      ;  different answer instead of the same one by luck.
  126  0000012c  20050007	addi r5, r0, 7
  127  00000130  200a0001	addi r10, r0, 1
