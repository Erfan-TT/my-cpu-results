 line   address	contents
    1                      ;=============================================================================
    2                      ;  11_btb_predictor -- BTB rows, prediction, and recovery from a mispredict
    3                      ;=============================================================================
    4                      ;  Checklist: D3/D4 (cold miss then warm hit), D5 (a loop re-entered, so its
    5                      ;  branch is already saturated the second time round), D6/D7 (mispredicts in
    6                      ;  both directions), D8 (two branches that alias to the same BTB row), D9 (one
    7                      ;  jalr instruction whose target changes between executions).
    8                      ;
    9                      ;  The BTB is 16 rows indexed by pc[5:2], so two branches whose addresses
   10                      ;  differ by 64 bytes share a row.  The two loops below are placed with
   11                      ;  '.text' at fixed addresses precisely so their bnez instructions land at
   12                      ;  0x48 and 0x88 -- both index 2 -- and evict each other on every alternation.
   13                      ;  The gaps are NOP-padded by the assembler and never executed.
   14                      ;
   15                      ;  A data-memory dump cannot see a prediction, only its consequences: if the
   16                      ;  BTB hands out a wrong target, or a mispredict is not flushed and repaired,
   17                      ;  the trip counts below come out wrong.  For the hit/miss rates themselves,
   18                      ;  watch take/flush in the waveform.
   19                      ;
   20                      ;  Result map:
   21                      ;    0 loop A trips (12)       1 loop B trips (12)     2 re-entered loop (10)
   22                      ;    3 alternating, odd (8)    4 alternating, even (8) 5 changing jalr target
   23                      ;=============================================================================
   24  00000000          	
   25  00000000          	.text 0
   26  00000000  0800008c	j    main
   27  00000004          	
   28                      ;-----------------------------------------------------------------------------
   29                      ;  Loop A: its bnez sits at 0x48.
   30                      ;-----------------------------------------------------------------------------
   31  00000004          	.text 0x40
   32  00000040  20c60001	loopA:  addi r6, r6, 1              ; 0x40
   33  00000044  28a50001	subi r5, r5, 1              ; 0x44
   34  00000048  14a0fff4	bnez r5, loopA              ; 0x48  -> BTB row (0x48>>2) mod 16 = 2
   35  0000004c  08000058	j    retA                   ; 0x4C
   36  00000050          	
   37                      ;-----------------------------------------------------------------------------
   38                      ;  Loop B: its bnez sits at 0x88, exactly 64 bytes after loop A's, so it maps
   39                      ;  to the same BTB row and the two keep evicting one another.
   40                      ;-----------------------------------------------------------------------------
   41  00000050          	.text 0x80
   42  00000080  21290001	loopB:  addi r9, r9, 1              ; 0x80
   43  00000084  28e70001	subi r7, r7, 1              ; 0x84
   44  00000088  14e0fff4	bnez r7, loopB              ; 0x88  -> BTB row 2 as well
   45  0000008c  08000020	j    retB                   ; 0x8C
   46  00000090          	
   47                      ;-----------------------------------------------------------------------------
   48  00000090          	.text 0x90
   49  00000090          	main:
   50  00000090  00003020	add  r6, r0, r0
   51  00000094  00004820	add  r9, r0, r0
   52  00000098  0000d020	add  r26, r0, r0
   53  0000009c  20040004	addi r4, r0, 4              ; four alternations between A and B
   54  000000a0          	alt:
   55  000000a0  20050003	addi r5, r0, 3
   56  000000a4  0bffff98	j    loopA
   57  000000a8          	retA:
   58  000000a8  20070003	addi r7, r0, 3
   59  000000ac  0bffffd0	j    loopB
   60  000000b0          	retB:
   61  000000b0  28840001	subi r4, r4, 1
   62  000000b4  1480ffe8	bnez r4, alt
   63  000000b8  ac060000	sw    0(r0), r6             ; 12
   64  000000bc  ac090004	sw    4(r0), r9             ; 12
   65  000000c0          	
   66                      ;---- D3/D4/D5: the same inner loop entered twice ----------------------------
   67                      ;  First entry is a cold BTB miss on every trip until the row is allocated;
   68                      ;  the second entry starts with the row already saturated at "strongly taken".
   69  000000c0  200d0002	addi r13, r0, 2
   70  000000c4  00006020	add  r12, r0, r0
   71  000000c8          	reenter:
   72  000000c8  200b0005	addi r11, r0, 5
   73  000000cc  218c0001	inner:  addi r12, r12, 1
   74  000000d0  296b0001	subi r11, r11, 1
   75  000000d4  1560fff4	bnez r11, inner
   76  000000d8  29ad0001	subi r13, r13, 1
   77  000000dc  15a0ffe8	bnez r13, reenter
   78  000000e0  ac0c0008	sw    8(r0), r12            ; 10
   79  000000e4          	
   80                      ;---- D6/D7: a branch that alternates every trip -----------------------------
   81                      ;  Worst case for a 2-bit counter: whatever it predicts, it is wrong about
   82                      ;  half the time, so both arms have to be repaired correctly.
   83  000000e4  200e0010	addi r14, r0, 16
   84  000000e8  00007820	add  r15, r0, r0
   85  000000ec  00008020	add  r16, r0, r0
   86  000000f0  31d10001	altb:   andi r17, r14, 1
   87  000000f4  12200008	beqz r17, alt_even
   88  000000f8  21ef0001	addi r15, r15, 1            ; odd trips
   89  000000fc  08000004	j    alt_next
   90  00000100          	alt_even:
   91  00000100  22100001	addi r16, r16, 1            ; even trips
   92  00000104          	alt_next:
   93  00000104  29ce0001	subi r14, r14, 1
   94  00000108  15c0ffe4	bnez r14, altb
   95  0000010c  ac0f000c	sw   12(r0), r15            ; 8
   96  00000110  ac100010	sw   16(r0), r16            ; 8
   97  00000114          	
   98                      ;---- D9: one jalr instruction, two different targets ------------------------
   99                      ;  The BTB records a JR/JALR target too.  The second pass must not jump to
  100                      ;  the target cached from the first.
  101  00000114  20180134	addi r24, r0, jt_a
  102  00000118  20190002	addi r25, r0, 2
  103  0000011c  4f000000	jrl:    jalr r24
  104  00000120  2018013c	addi r24, r0, jt_b          ; next time round, somewhere else
  105  00000124  2b390001	subi r25, r25, 1
  106  00000128  1720fff0	bnez r25, jrl
  107  0000012c  ac1a0014	sw   20(r0), r26            ; 1 + 10 = 11
  108  00000130  08000010	j    end
  109  00000134          	
  110  00000134  235a0001	jt_a:   addi r26, r26, 1
  111  00000138  4be00000	jr   r31
  112  0000013c  235a000a	jt_b:   addi r26, r26, 10
  113  00000140  4be00000	jr   r31
  114  00000144          	
  115  00000144  0bfffffc	end:    j end
