 line   address	contents
    1                      ; Compact exception exercise -- one hit per cause, plus both illegal
    2                      ; special-register indices.  Every handler dumps marker/CAUSE/TVAL/STATUS/IAR
    3                      ; and returns with IAR+4, so the run is fully checkable against dlxsim.py.
    4                      ;
    5                      ; NOTE: the FP mnemonics (addf, multf, ...) are NOT usable as "illegal
    6                      ; instruction" here -- they all assemble to opcode 0x01, which this ISA uses
    7                      ; for bltz, so they execute as a branch.  Use sb/sh/lf/sf/itlb or a .word.
    8  00000000  20010010	addi r1, r0, vector_base
    9  00000004  00200030	movi2s VBR, r1
   10  00000008  08000014	j main
   11  0000000c  54000000	nop                         ; pad: special_pc substitutes CAUSE into
   12                      ; PC bits 3:2, so VBR must be 16-byte aligned
   13  00000010          	
   14  00000010          	vector_base:
   15  00000010  08000040	j illegal_handler           ; cause 0
   16  00000014  08000044	j trap_handler              ; cause 1
   17  00000018  08000048	j inst_mis_handler          ; cause 2
   18  0000001c  0800004c	j data_mis_handler          ; cause 3
   19  00000020          	
   20  00000020          	main:
   21  00000020  00005020	add  r10, r0, r0            ; dump pointer
   22  00000024          	
   23  00000024  44000007	trap 7                      ; cause 1, tval 7
   24  00000028  00000000	.word 0x00000000            ; cause 0 : opcode 0 with func 0 is illegal
   25  0000002c  8c130012	lw   r19, 18(r0)            ; cause 3, tval 18
   26  00000030  20030009	addi r3, r0, 9
   27  00000034  48600000	jr   r3                     ; cause 2, tval 9
   28  00000038          	
   29  00000038  0020f030	movi2s r30, r1              ; cause 0 : SR write index 30 >= 5
   30  0000003c  001e2031	movs2i r4,  r30             ; cause 0 : SR read  index 30 >= 5
   31  00000040          	
   32  00000040  00042831	movs2i r5, STATUS           ; after all returns: IE back, EXL clear
   33  00000044  ad450000	sw  0(r10), r5
   34  00000048  214a0004	addi r10, r10, 4
   35  0000004c  08000000	j end
   36  00000050          	end:
   37  00000050  0bfffffc	j end
   38  00000054          	
   39  00000054          	illegal_handler:
   40  00000054  200b0064	addi r11, r0, 100
   41  00000058  08000014	j    common
   42  0000005c          	trap_handler:
   43  0000005c  200b00c8	addi r11, r0, 200
   44  00000060  0800000c	j    common
   45  00000064          	inst_mis_handler:
   46  00000064  200b012c	addi r11, r0, 300
   47  00000068  08000004	j    common
   48  0000006c          	data_mis_handler:
   49  0000006c  200b0190	addi r11, r0, 400
   50  00000070          	common:
   51  00000070  ad4b0000	sw  0(r10), r11
   52  00000074  214a0004	addi r10, r10, 4
   53  00000078  00022831	movs2i r5, CAUSE
   54  0000007c  ad450000	sw  0(r10), r5
   55  00000080  214a0004	addi r10, r10, 4
   56  00000084  00032831	movs2i r5, TVAL
   57  00000088  ad450000	sw  0(r10), r5
   58  0000008c  214a0004	addi r10, r10, 4
   59  00000090  00042831	movs2i r5, STATUS
   60  00000094  ad450000	sw  0(r10), r5
   61  00000098  214a0004	addi r10, r10, 4
   62  0000009c  00014031	movs2i r8, IAR
   63  000000a0  ad480000	sw  0(r10), r8
   64  000000a4  214a0004	addi r10, r10, 4
   65  000000a8  21080004	addi r8, r8, 4
   66  000000ac  01000830	movi2s IAR, r8
