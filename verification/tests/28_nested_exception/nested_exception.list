 line   address	contents
    1                      ;=============================================================================
    2                      ;  28_nested_exception -- an exception raised inside a handler
    3                      ;=============================================================================
    4                      ;  Checklist F11 and F12.
    5                      ;
    6                      ;  F11.  The hardware has no special case for an exception taken while EXL is
    7                      ;  already 1: the commit overwrites IAR, CAUSE and TVAL and stacks the STATUS
    8                      ;  bits again (PIE <- IE, IE <- 0, EXL <- 1).  A handler that wants to cause
    9                      ;  or survive a nested exception therefore saves IAR and STATUS first and
   10                      ;  restores them before its own rfe.  This program does exactly that:
   11                      ;     main         trap 7                    STATUS 1 -> 6  (PIE=1 EXL=1 IE=0)
   12                      ;     trap handler saves IAR/STATUS, then a misaligned lw (cause 3)
   13                      ;                                            STATUS 6 -> 2  (PIE=0 EXL=1 IE=0)
   14                      ;     data handler logs, rfe                 STATUS 2 -> 0  (IE <- PIE = 0)
   15                      ;     trap handler restores STATUS = 6 and IAR, rfe
   16                      ;                                            STATUS 6 -> 5  (IE <- PIE = 1)
   17                      ;  Every STATUS value on the way is stored, so the golden model checks the
   18                      ;  stacking at each step.
   19                      ;
   20                      ;  F12.  When the trap commits in MEM, the two loads behind it are squashed.
   21                      ;  The second is still in ID at that moment, and without the scoreboard flush
   22                      ;  on commit (special_pc_sel) it would leave r21 marked busy for two cycles.
   23                      ;  The trap's vector entry is a branch on r21, in ID two cycles after the
   24                      ;  commit, so a missed flush shows up as a hazard stall right there.
   25                      ;  check_timing.py looks for that stall in the VCD.  r21 also checks the squash:
   26                      ;  if either load wrote r21 before the vector entry read it, the branch would
   27                      ;  fall through to the next entry and other_handler would mark word 11.
   28                      ;
   29                      ;  Result map:
   30                      ;    0 STATUS in the trap handler (6)    1 CAUSE there (1)    2 TVAL there (7)
   31                      ;    3 CAUSE nested (3)                  4 TVAL nested (3)    5 IAR nested (lw_bad)
   32                      ;    6 STATUS nested (2)                 7 STATUS after the nested rfe (0)
   33                      ;    8 STATUS back in main (5)           9 nested returns (1)
   34                      ;   10 r21 after the trap returns (0x123, the loads ran once, after the trap)
   35                      ;   11 unexpected cause, must stay 0
   36                      ;=============================================================================
   37  00000000          	
   38  00000000          	.text
   39  00000000  20010010	addi   r1, r0, vec_table
   40  00000004  00200030	movi2s VBR, r1
   41  00000008  08000014	j      main
   42  0000000c  54000000	nop                         ; pad: VBR must be 16-byte aligned
   43  00000010          	
   44  00000010          	vec_table:
   45  00000010  080000b0	j     other_handler         ; cause 0, illegal
   46  00000014  12a00040	beqz  r21, trap_handler     ; cause 1, trap -- see F12 above
   47  00000018  080000a8	j     other_handler         ; cause 2, misaligned target
   48  0000001c  08000078	j     dmis_handler          ; cause 3, misaligned data
   49  00000020          	
   50  00000020          	main:
   51  00000020  0000a820	add  r21, r0, r0            ; stays 0 until the loads below retire
   52  00000024  0000d020	add  r26, r0, r0            ; nested returns
   53  00000028  20160123	addi r22, r0, 0x123
   54  0000002c  ac16003c	sw   60(r0), r22            ; what the loads behind the trap read
   55  00000030  54000000	nop
   56  00000034  54000000	nop
   57  00000038  44000007	trap 7
   58  0000003c  8c15003c	lw   r21, 60(r0)            ; squashed at the commit, runs after rfe
   59  00000040  8c15003c	lw   r21, 60(r0)            ; in ID at the commit
   60  00000044  00045831	movs2i r11, STATUS
   61  00000048  ac0b0020	sw   32(r0), r11            ; 5
   62  0000004c  ac1a0024	sw   36(r0), r26            ; 1
   63  00000050  ac150028	sw   40(r0), r21            ; 0x123
   64  00000054  08000084	j    end
   65  00000058          	
   66  00000058          	trap_handler:
   67  00000058  0001c031	movs2i r24, IAR             ; save the outer state
   68  0000005c  0004c831	movs2i r25, STATUS
   69  00000060  ac190000	sw   0(r0), r25             ; 6
   70  00000064  00025831	movs2i r11, CAUSE
   71  00000068  ac0b0004	sw   4(r0), r11             ; 1
   72  0000006c  00035831	movs2i r11, TVAL
   73  00000070  ac0b0008	sw   8(r0), r11             ; 7
   74  00000074  200c0002	addi r12, r0, 2
   75  00000078  8d8d0001	lw_bad: lw   r13, 1(r12)            ; address 3: nested DATA_ADDR_MISALIGNED
   76  0000007c  235a0001	addi r26, r26, 1            ; the nested handler returns here
   77  00000080  00045831	movs2i r11, STATUS
   78  00000084  ac0b001c	sw   28(r0), r11            ; 0
   79  00000088  03202030	movi2s STATUS, r25          ; restore the outer state
   80  0000008c  23180004	addi r24, r24, 4            ; and step over the trap
   81  00000090  03000830	movi2s IAR, r24
   82  00000094  40000000	rfe
   83  00000098          	
   84  00000098          	dmis_handler:
   85  00000098  00025831	movs2i r11, CAUSE
   86  0000009c  ac0b000c	sw   12(r0), r11            ; 3
   87  000000a0  00035831	movs2i r11, TVAL
   88  000000a4  ac0b0010	sw   16(r0), r11            ; 3
   89  000000a8  00014031	movs2i r8, IAR
   90  000000ac  ac080014	sw   20(r0), r8             ; lw_bad
   91  000000b0  00045831	movs2i r11, STATUS
   92  000000b4  ac0b0018	sw   24(r0), r11            ; 2
   93  000000b8  21080004	addi r8, r8, 4
   94  000000bc  01000830	movi2s IAR, r8
   95  000000c0  40000000	rfe
   96  000000c4          	
   97  000000c4          	other_handler:
   98  000000c4  200b03e7	addi r11, r0, 999
   99  000000c8  ac0b002c	sw   44(r0), r11
  100  000000cc  00014031	movs2i r8, IAR
  101  000000d0  21080004	addi r8, r8, 4
  102  000000d4  01000830	movi2s IAR, r8
  103  000000d8  40000000	rfe
  104  000000dc          	
  105  000000dc  0bfffffc	end:    j end
